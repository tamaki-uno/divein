# =============================================================================
# DIVEIN API Server Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# Required variables are marked with [REQUIRED]
# Optional variables have default values shown in brackets

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Secret Key [REQUIRED]
# Generate a secure random string (256 bits recommended)
# Example: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Token Configuration
# Token expiration time in minutes [Default: 10080 = 1 week]
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# JWT Algorithm [Default: HS256]
ALGORITHM=HS256

# =============================================================================
# OAUTH2 PROVIDERS
# =============================================================================

# Google OAuth2 [REQUIRED]
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth2 [REQUIRED]
# Get credentials from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type [Default: sqlite]
# Options: sqlite, postgresql
DATABASE_TYPE=sqlite

# SQLite Configuration (used when DATABASE_TYPE=sqlite)
# Database file will be created automatically in the project directory
SQLITE_DATABASE=./divein_notes.db

# =============================================================================
# POSTGRESQL CONFIGURATION (only when DATABASE_TYPE=postgresql)
# =============================================================================

# PostgreSQL Connection [REQUIRED when using PostgreSQL]
POSTGRES_USER=divein_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=divein_db

# PostgreSQL Connection Pool (optional)
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=5

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Configuration
PROJECT_NAME=DIVEIN API
VERSION=1.0.0
DESCRIPTION=Note synchronization API for DIVEIN application

# API Prefix [Default: /api/v1]
API_V1_STR=/api/v1

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins for CORS (comma-separated)
# For development, include your frontend URL
# For production, specify exact domains
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Debug Mode [Default: false]
# Set to true for detailed error messages in development
DEBUG=false

# Log Level [Default: info]
# Options: debug, info, warning, error, critical
LOG_LEVEL=info

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Rate Limiting (if implemented)
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits (if implemented)
MAX_FILE_SIZE=10485760  # 10MB in bytes

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Development Example (SQLite):
# DATABASE_TYPE=sqlite
# SQLITE_DATABASE=./dev_notes.db
# DEBUG=true
# LOG_LEVEL=debug

# Production Example (PostgreSQL):
# DATABASE_TYPE=postgresql
# POSTGRES_SERVER=db.example.com
# POSTGRES_DB=divein_production
# DEBUG=false
# LOG_LEVEL=warning
