# =============================================================================
# DIVEIN API Server - Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# 
# Quick Setup:
# 1. For Development (SQLite):   Uncomment "DEVELOPMENT PRESET" section
# 2. For Production (PostgreSQL): Uncomment "PRODUCTION PRESET" section
# 3. Update OAuth credentials and SECRET_KEY

# =============================================================================
# CORE CONFIGURATION [REQUIRED]
# =============================================================================

# Environment Type: development, staging, production
ENVIRONMENT=development

# JWT Secret Key [REQUIRED - MUST CHANGE THIS]
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-immediately

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 1 week (adjust for production: 1440 = 24h)

# =============================================================================
# OAUTH2 AUTHENTICATION [REQUIRED]
# =============================================================================

# Google OAuth2
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth2  
# Get from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type: sqlite, postgresql
DATABASE_TYPE=sqlite

# SQLite Configuration (for development)
SQLITE_DATABASE=./divein_notes.db

# PostgreSQL Configuration (for production)
POSTGRES_USER=divein_user
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=divein_db
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=5

# =============================================================================
# API & CORS CONFIGURATION
# =============================================================================

# API Settings
PROJECT_NAME=DIVEIN API
VERSION=1.0.0
DESCRIPTION=Note synchronization API for DIVEIN application
API_V1_STR=/api/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Logging & Debug
DEBUG=false
LOG_LEVEL=info

# Performance & Security
RATE_LIMIT_PER_MINUTE=60
MAX_FILE_SIZE=10485760  # 10MB

# =============================================================================
# PRESET CONFIGURATIONS
# =============================================================================

# -----------------------------------------------------------------------------
# DEVELOPMENT PRESET (SQLite + Debug)
# -----------------------------------------------------------------------------
# Uncomment the lines below for local development:

# ENVIRONMENT=development
# DATABASE_TYPE=sqlite
# SQLITE_DATABASE=./dev_notes.db
# DEBUG=true
# LOG_LEVEL=debug
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# PROJECT_NAME=DIVEIN API (Dev)
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# PRODUCTION PRESET (PostgreSQL + Security)
# -----------------------------------------------------------------------------
# Uncomment and configure the lines below for production:

# ENVIRONMENT=production
# DATABASE_TYPE=postgresql
# POSTGRES_SERVER=your-production-db-host.com
# POSTGRES_DB=divein_production
# POSTGRES_USER=divein_prod_user
# POSTGRES_PASSWORD=very_secure_production_password_123
# DEBUG=false
# LOG_LEVEL=warning
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PROJECT_NAME=DIVEIN API
# BACKEND_CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# -----------------------------------------------------------------------------
# STAGING PRESET (PostgreSQL + Extended Logging)
# -----------------------------------------------------------------------------
# Uncomment and configure the lines below for staging:

# ENVIRONMENT=staging
# DATABASE_TYPE=postgresql
# POSTGRES_SERVER=staging-db.yourdomain.com
# POSTGRES_DB=divein_staging
# DEBUG=false
# LOG_LEVEL=info
# ACCESS_TOKEN_EXPIRE_MINUTES=2880
# PROJECT_NAME=DIVEIN API (Staging)
# BACKEND_CORS_ORIGINS=https://staging.yourdomain.com

# =============================================================================
# ADVANCED CONFIGURATION (Optional)
# =============================================================================

# Monitoring & Analytics (uncomment if using)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-azure-connection-string

# Custom Features (uncomment if implemented)
# EMAIL_ENABLED=false
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Redis Cache (uncomment if using)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file: cp .env.example .env
# 
# 2. Generate SECRET_KEY:
#    openssl rand -hex 32
#
# 3. Configure OAuth2:
#    - Google: https://console.cloud.google.com/apis/credentials
#    - GitHub: https://github.com/settings/applications/new
#
# 4. Choose environment preset (uncomment one of the preset sections above)
#
# 5. For production: Update database credentials and CORS origins
#
# 6. Test configuration: uvicorn app.main:app --reload
#
# =============================================================================
