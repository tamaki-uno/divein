# =============================================================================
# DIVEIN API Server - Quick Development Setup (SQLite)
# =============================================================================
# Copy this file to .env for instant development setup
# Optimized for: Local development with SQLite database

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=development

# Security [CHANGE THIS]
SECRET_KEY=dev-secret-key-change-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 1 week

# OAuth2 Credentials [REQUIRED - GET FROM PROVIDERS]
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# DEVELOPMENT OPTIMIZED SETTINGS
# =============================================================================

# Database - SQLite (no setup required)
DATABASE_TYPE=sqlite
SQLITE_DATABASE=./divein_notes.db

# API
PROJECT_NAME=DIVEIN API (Development)
VERSION=1.0.0-dev
DESCRIPTION=Note synchronization API - Development Environment
API_V1_STR=/api/v1

# CORS - Allow all local development servers
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Debug & Logging
DEBUG=true
LOG_LEVEL=debug

# Performance (relaxed for development)
RATE_LIMIT_PER_MINUTE=1000
MAX_FILE_SIZE=52428800  # 50MB

# =============================================================================
# QUICK START GUIDE
# =============================================================================
#
# 1. Copy this file:
#    cp .env.sqlite.example .env
#
# 2. Get OAuth credentials:
#    Google: https://console.cloud.google.com/apis/credentials  
#    GitHub: https://github.com/settings/applications/new
#
# 3. Update OAuth credentials above
#
# 4. Start server:
#    uvicorn app.main:app --reload
#
# 5. Visit: http://localhost:8000/docs
#
# =============================================================================

