# =============================================================================
# DIVEIN API Server - SQLite Development Configuration
# =============================================================================
# This configuration is optimized for local development with SQLite database.
# Copy this file to .env for development setup.

# =============================================================================
# SECURITY & AUTHENTICATION [REQUIRED]
# =============================================================================

# JWT Secret Key - Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_replace_this_in_production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 1 week for development

# =============================================================================
# OAUTH2 PROVIDERS [REQUIRED]
# =============================================================================

# Google OAuth2 - Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth2 - Get from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# DATABASE CONFIGURATION - SQLite
# =============================================================================

DATABASE_TYPE=sqlite
SQLITE_DATABASE=./divein_notes.db

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# API Configuration
PROJECT_NAME=DIVEIN API (Development)
VERSION=1.0.0-dev
DESCRIPTION=Note synchronization API for DIVEIN application (Development)

# CORS - Allow development servers
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Debug Mode
DEBUG=true
LOG_LEVEL=debug

