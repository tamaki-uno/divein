# =============================================================================
# DIVEIN API Server - Environment Templates
# =============================================================================
# Quick setup guide for different environments

# Choose your setup method:

# 1. DEVELOPMENT (SQLite - Fastest setup)
#    cp .env.sqlite.example .env

# 2. PRODUCTION (PostgreSQL - Full features)  
#    cp env.postgresql.example .env

# 3. CUSTOM (Full configuration)
#    cp .env.example .env

# =============================================================================
# MINIMAL DEVELOPMENT SETUP
# =============================================================================
# For immediate testing with minimal configuration:

ENVIRONMENT=development
SECRET_KEY=dev-key-replace-in-production
DATABASE_TYPE=sqlite
SQLITE_DATABASE=./test_notes.db
GOOGLE_CLIENT_ID=test_google_id
GOOGLE_CLIENT_SECRET=test_google_secret
GITHUB_CLIENT_ID=test_github_id
GITHUB_CLIENT_SECRET=test_github_secret
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Choose environment template above
# 2. Copy to .env file
# 3. Update OAuth credentials (required for authentication)
# 4. Run: uvicorn app.main:app --reload
# 5. Visit: http://localhost:8000/docs
#
# OAuth Setup URLs:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/applications/new
#
# =============================================================================
