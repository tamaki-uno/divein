# =============================================================================
# DIVEIN API Server - PostgreSQL Production Configuration
# =============================================================================
# This configuration is optimized for production deployment with PostgreSQL.
# Copy this file to .env for production setup.

# =============================================================================
# SECURITY & AUTHENTICATION [REQUIRED]
# =============================================================================

# JWT Secret Key - MUST be changed for production!
# Generate with: openssl rand -hex 32
SECRET_KEY=your_production_secret_key_change_this

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for production

# =============================================================================
# OAUTH2 PROVIDERS [REQUIRED]
# =============================================================================

# Google OAuth2 - Production credentials
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# GitHub OAuth2 - Production credentials  
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret

# =============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# =============================================================================

DATABASE_TYPE=postgresql

# PostgreSQL Connection Details
POSTGRES_USER=divein_user
POSTGRES_PASSWORD=your_very_secure_production_password
POSTGRES_SERVER=your_postgres_host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=divein_production_db

# Connection Pool Configuration
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=5

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# API Configuration
PROJECT_NAME=DIVEIN API
VERSION=1.0.0
DESCRIPTION=Note synchronization API for DIVEIN application

# CORS - Specify exact production domains
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Production Settings
DEBUG=false
LOG_LEVEL=warning

# =============================================================================
# SECURITY HEADERS & FEATURES
# =============================================================================

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================

# Sentry DSN for error tracking (if using Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Application Insights (if using Azure)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string