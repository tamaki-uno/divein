# =============================================================================
# DIVEIN API Server - Production Setup (PostgreSQL)
# =============================================================================
# Copy this file to .env for production deployment
# Optimized for: Production environment with PostgreSQL

# =============================================================================
# REQUIRED PRODUCTION CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=production

# Security [CRITICAL - CHANGE THESE]
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_256_BIT_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# OAuth2 Production Credentials [REQUIRED]
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret

# =============================================================================
# PRODUCTION DATABASE - POSTGRESQL
# =============================================================================

DATABASE_TYPE=postgresql

# PostgreSQL Connection [CONFIGURE FOR YOUR DB SERVER]
POSTGRES_USER=divein_prod_user
POSTGRES_PASSWORD=very_secure_production_password
POSTGRES_SERVER=your-postgres-host.com
POSTGRES_PORT=5432
POSTGRES_DB=divein_production

# Connection Pool (production optimized)
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=5

# =============================================================================
# PRODUCTION API SETTINGS
# =============================================================================

# API Configuration
PROJECT_NAME=DIVEIN API
VERSION=1.0.0
DESCRIPTION=Note synchronization API for DIVEIN application
API_V1_STR=/api/v1

# CORS [CONFIGURE FOR YOUR DOMAINS]
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Security & Performance
DEBUG=false
LOG_LEVEL=warning
RATE_LIMIT_PER_MINUTE=60
MAX_FILE_SIZE=10485760  # 10MB

# =============================================================================
# OPTIONAL PRODUCTION FEATURES
# =============================================================================

# Monitoring (uncomment if using)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Caching (uncomment if using Redis)
# REDIS_URL=redis://your-redis-host:6379

# Email notifications (uncomment if needed)
# EMAIL_ENABLED=false
# EMAIL_SMTP_HOST=smtp.yourdomain.com
# EMAIL_SMTP_PORT=587

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
#
# 1. Security:
#    ✓ Generate SECRET_KEY: openssl rand -hex 32
#    ✓ Use strong database passwords
#    ✓ Configure HTTPS for OAuth redirects
#
# 2. Database:
#    ✓ Setup PostgreSQL server
#    ✓ Create production database
#    ✓ Configure connection pooling
#
# 3. OAuth Setup:
#    ✓ Register production OAuth apps
#    ✓ Configure correct redirect URIs
#    ✓ Use production client credentials
#
# 4. CORS:
#    ✓ Set exact production domains
#    ✓ Remove development URLs
#
# 5. Monitoring:
#    ✓ Setup error tracking (Sentry)
#    ✓ Configure logging
#    ✓ Monitor performance
#
# 6. Testing:
#    ✓ Test OAuth flows
#    ✓ Verify API endpoints
#    ✓ Check database connections
#
# =============================================================================